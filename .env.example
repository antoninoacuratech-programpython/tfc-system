# Copie para .env e ajuste. Nunca coloque o .env no git.

# Desenvolvimento: True | Produção: False
DEBUG=True

# Obrigatória em produção. Gere com:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# PostgreSQL (Neon / Render). Sem esta variável é usado o SQLite local (db.sqlite3).
# DATABASE_URL=postgresql://utilizador:senha@host/base?sslmode=require

# Servir uploads pelo Django quando DEBUG=False (ex.: Render sem armazenamento externo)
SERVE_MEDIA=False

# Identidade institucional mostrada no sistema
INSTITUICAO_NOME=Instituto Superior Politécnico do Bié
INSTITUICAO_SIGLA=ISP-Bié
SISTEMA_NOME=SGTF
